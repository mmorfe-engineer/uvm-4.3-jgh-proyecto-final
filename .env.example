# Configuración del Entorno de Desarrollo (JGH 4.3)
NODE_ENV=development
PORT=5000
FRONTEND_PORT=3000

# Base de Datos MongoDB
# Para desarrollo local puede usarse una instancia local o el runner persistente integrado
MONGO_URI=mongodb://127.0.0.1:27017/jgh_encuestas_dev

# Seguridad de Sesión
SESSION_SECRET=clave_secreta_de_sesion_para_desarrollo_local_min32caracteres

# CORS
CLIENT_ORIGIN=http://localhost:3000

# Rutas de Archivos
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=3
